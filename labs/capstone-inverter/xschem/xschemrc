# AD103 project-local XSchem configuration.
# XSchem reads ./xschemrc from the directory it is started in, so keep this
# file next to your schematics and launch xschem from here.

# Pull in the SKY130 device libraries. $env(PDK) must be sky130A; if it is not,
# this line loads the IHP SG13G2 libraries instead and every sky130 symbol goes
# missing. See docs/guide/getting-started.md.
source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc

# Write netlists to ./simulation/ next to the schematic instead of the
# container-only default ~/.xschem/simulations/, which is wiped when the
# container is removed. Same as Simulation -> "Use 'simulation' dir in
# schematic dir" in the menu.
set local_netlist_dir 1

# The PDK's xschemrc (sourced above) points XSchem's start page at
# sky130_tests/top.sch, which lives INSIDE the read-only PDK. Launched with no
# filename, XSchem would open that page, and with local_netlist_dir set the
# Netlist button then tries to create simulation/ next to it and dies with
#   can't create directory
#   "/foss/pdks/sky130A/libs.tech/xschem/sky130_tests/simulation": permission denied
# Blanking the start window makes a bare `xschem &` open an empty untitled.sch
# in THIS directory instead, which is writable. See docs/guide/getting-started.md §5.
set XSCHEM_START_WINDOW {}

# Keep the symbol chooser on screen.
#
# XSchem places "Choose symbol" relative to the main window, and the main window
# is nearly as wide as the screen. On the 1280x800 noVNC desktop the chooser
# therefore lands at about x=1079 at 734x373 - roughly a quarter of it visible,
# with the library pane, the file list and OK all off the right edge. Pinning a
# geometry here puts it fully on screen instead. Measured before: 201 of 734 px
# visible; after: the whole window at (41,85).
set file_dialog_default_geometry 900x640+40+40
